# このファイルを .env にコピーして値を設定する（.env はコミットされない）
OPENAI_API_KEY=

# --- 第13章(PostgreSQL)--------------------------------------------------
# パスワードは、それぞれ別の値にする。例: openssl rand -base64 18
# (`@` `/` `:` などを含んでも、接続は部品から組み立てるので壊れない)
# DB_OWNER_*: DDL(Tableの作成)をする管理者。migrate ジョブだけが使う
DB_OWNER_PASSWORD=
# DB_RO_PASSWORD: 読み取り専用の役割(agent_ro)。api が使う
DB_RO_PASSWORD=
# DB_RW_PASSWORD: レビュー依頼の登録だけができる役割(agent_rw)。api が使う
DB_RW_PASSWORD=
# 本番ではデモデータを入れない
# SEED_DEMO_DATA=false

# syntax=docker/dockerfile:1
FROM python:3.13.16-slim@sha256:70729b46c69b4f1e97c4822c1af3df53a1476cf5ddc6c087c0c10bc3a5678c2f

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /app

RUN pip install --no-cache-dir uv==0.11.16
COPY pyproject.toml uv.lock ./
# 画面に必要なのは streamlit と httpx だけ。Agent・DB・pandas は入れない。
RUN uv sync --locked --no-dev --only-group ui

COPY chapters/ch11-fastapi/src/ui ./ui

RUN useradd --system --uid 10001 --home-dir /nonexistent app
USER app

# Streamlit が設定を書く場所を、書き込める/tmpにする(ルートFSは読み取り専用で動かす)。
ENV PATH="/app/.venv/bin:$PATH" \
    HOME=/tmp \
    STREAMLIT_SERVER_HEADLESS=true \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

EXPOSE 8501

CMD ["streamlit", "run", "ui/app.py", "--server.address=0.0.0.0", "--server.port=8501"]

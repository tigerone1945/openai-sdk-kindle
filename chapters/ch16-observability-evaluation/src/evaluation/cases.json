      ]
    }
  },
  {
    "id": "followup-001",
    "kind": "conversation",
    "turns": [
      {
        "question": "地域別の売上を分析してください"
      },
      {
        "question": "その中で一番売上が大きい地域の、売上金額だけを教えてください",
        "expect": {
          "facts": [
            "region:東北"
          ],
          "must_contain": [
            "東北"
          ]
        }
      }
    ]
  },
  {

      "facts": [
        "region:東北",
        "region:関西",
        "region:九州",
        "region:関東",
        "region:中部"
      ],
      "consistent_with": [
        "region"
      ]
    }
  },
  {
    "id": "region-002",
    "kind": "analysis",
    "question": "売上が一番少ない地域はどこですか",

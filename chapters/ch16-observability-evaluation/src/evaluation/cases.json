      "facts": [
        "category:IT機器",
        "category:オフィス家具",
        "category:ストレージ",
        "category:周辺機器"
      ],
      "consistent_with": [
        "category"
      ]
    }
  },
  {
    "id": "customer-type-001",
    "kind": "analysis",
    "question": "法人と個人の売上を比較してください",
    "expect": {
      "analysis_type": "customer_type_sales",
      "facts": [
        "customer_type:法人",
        "customer_type:個人"
      ],
      "consistent_with": [
        "customer_type"
      ]
    }
  },
  {
    "id": "cancellation-001",
    "kind": "analysis",
    "question": "キャンセルは何件ありますか",
    "expect": {
      "analysis_type": "cancellation",
      "fact_regex": [

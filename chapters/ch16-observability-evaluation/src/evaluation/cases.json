[
  {
    "id": "overall-001",
    "kind": "analysis",
    "question": "売上全体をまとめてください",
    "expect": {
      "analysis_type": "overall_sales",
      "must_contain": [
        "キャンセル"
      ],
      "facts": [
        "total:-"
      ],
      "fact_regex": [
        "14\\s*件"
      ]
    }
  },
  {
    "id": "region-001",
    "kind": "analysis",
    "question": "地域別の売上を分析してください",
    "expect": {

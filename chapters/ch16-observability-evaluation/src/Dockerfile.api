# syntax=docker/dockerfile:1
# 第15章の Dockerfile.api との違い:
#   - service.py(構造化ログ)・observability.py・server.py(入口)は第16章のもの。agent_service.py は第15章のまま
#   - 起動は server:app(API のコードは変えず、リクエストの記録を足す)
#   - OPENAI_AGENTS_TRACE_INCLUDE_SENSITIVE_DATA=false: Tracing に、質問・回答・Tool の入出力を送らない(本番の既定)
FROM python:3.13.16-slim@sha256:70729b46c69b4f1e97c4822c1af3df53a1476cf5ddc6c087c0c10bc3a5678c2f

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_PYTHON_DOWNLOADS=never \
    AUDIT_LOG_DEST=stdout \
    OPENAI_AGENTS_TRACE_INCLUDE_SENSITIVE_DATA=false

WORKDIR /app

RUN pip install --no-cache-dir uv==0.11.16
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --only-group api

COPY chapters/ch16-observability-evaluation/src/service.py chapters/ch16-observability-evaluation/src/observability.py \
     chapters/ch16-observability-evaluation/src/server.py ./
COPY chapters/ch15-aws-deploy/src/agent_service.py ./
COPY chapters/ch13-postgresql/src/catalog.py chapters/ch13-postgresql/src/db.py \
     chapters/ch13-postgresql/src/repository.py chapters/ch13-postgresql/src/migrate.py \
     chapters/ch13-postgresql/src/seed.py ./
COPY chapters/ch15-aws-deploy/src/migrations ./migrations
COPY chapters/ch13-postgresql/src/api ./api

COPY data/raw/ai_agent_practice_sales.csv /app/seed/ai_agent_practice_sales.csv

RUN useradd --system --uid 10001 --home-dir /nonexistent app
USER app

ENV PATH="/app/.venv/bin:$PATH"

EXPOSE 8000

CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000"]

# 第13章の Dockerfile.api に、VOLUME の 1 行だけを足したもの(状態の実験用)。
# syntax=docker/dockerfile:1
# 第12章の Dockerfile.api との違いは、COPYするアプリ(SQLを知るのは repository.py だけ)と、migrations/ の追加。
FROM python:3.13.16-slim@sha256:70729b46c69b4f1e97c4822c1af3df53a1476cf5ddc6c087c0c10bc3a5678c2f

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /app

RUN pip install --no-cache-dir uv==0.11.16
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --only-group api

# アプリ(第13章で変わった部分)。API が使う service.py は、第11章のまま。
COPY chapters/ch13-postgresql/src/agent_service.py chapters/ch13-postgresql/src/catalog.py \
     chapters/ch13-postgresql/src/db.py chapters/ch13-postgresql/src/repository.py \
     chapters/ch13-postgresql/src/migrate.py chapters/ch13-postgresql/src/seed.py ./
COPY chapters/ch13-postgresql/src/migrations ./migrations
COPY chapters/ch13-postgresql/src/api ./api
COPY chapters/ch11-fastapi/src/service.py ./

# デモデータの元(読み取り専用の素材)。本番では、migrate が SEED_DEMO_DATA=true のときだけ使う。
COPY data/raw/ai_agent_practice_sales.csv /app/seed/ai_agent_practice_sales.csv

RUN useradd --system --uid 10001 --home-dir /nonexistent app \
    && mkdir -p /app/data \
    && chown app:app /app/data
# 実験用の 1 行(第15章): Fargate の空ボリュームを、イメージ側の所有者(app)のまま使えるようにする
VOLUME ["/app/data"]
USER app

ENV PATH="/app/.venv/bin:$PATH"

EXPOSE 8000

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
